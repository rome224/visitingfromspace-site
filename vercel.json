{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/questionnaire",
      "destination": "/questionnaire-for-site"
    }
  ],
  "redirects": [
    {
      "source": "/iphipi",
      "destination": "/iphipi/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(application|questionnaire)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/iphipi(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
