{
  "rewrites": [
    {
      "source": "/ces",
      "destination": "/ces.html"
    },
    {
      "source": "/ces2027",
      "destination": "/ces2027.html"
    },
    {
      "source": "/fox-news-application",
      "destination": "/fox-news-application.html"
    },
    {
      "source": "/application",
      "destination": "/application.html"
    },
    {
      "source": "/questionnaire",
      "destination": "/questionnaire-for-site.html"
    },
    {
      "source": "/questionnaire/admin",
      "destination": "/questionnaire-admin.html"
    },
    {
      "source": "/ces-case-study-gyrogear",
      "destination": "/ces-case-study-gyrogear.html"
    }
  ],
  "headers": [
    {
      "source": "/application(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(questionnaire|questionnaire\\.html|questionnaire/admin|questionnaire-for-site\\.html|questionnaire-admin\\.html|questionnaire-old\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
